<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Without these the agent reports 1.0.0.0 whatever build it came from. That was harmless
         while nothing read it; it stopped being harmless once DualConnectionService started
         sending this version on every heartbeat and BranchVersionReporterService started
         counting how many of a branch's PCs are on it - a fleet that all claims 1.0.0.0 would
         make "N of M gaming PCs up to date" a guess again. This had drifted to 3.0.0 across
         several releases where the other three version files (Api.csproj, Desktop.csproj,
         AppleEsportsBranch.iss) were correctly bumped and this one was not - a fourth file to
         remember, kept in step by hand same as the rest. -->
    <Version>3.1.108</Version>
    <FileVersion>3.1.108.0</FileVersion>
    <AssemblyVersion>3.1.108.0</AssemblyVersion>
    <AssemblyName>AppleEsportsAgent</AssemblyName>
    <RootNamespace>AppleEsportsErp.ClientAgent</RootNamespace>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.agent.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo.ico" />
  </ItemGroup>

</Project>
